{
  "name": "screenlet",
  "productName": "Screenlet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/bundle-remotion.mjs",
    "lint": "eslint .",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c blue,green \"next dev\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
    "dist": "node scripts/install-cross-compositors.mjs && npm run build && electron-builder",
    "dist:mac": "node scripts/install-cross-compositors.mjs && npm run build && electron-builder --mac",
    "dist:mac:arm64": "node scripts/install-cross-compositors.mjs && npm run build && electron-builder --mac --arm64",
    "dist:mac:intel": "node scripts/install-cross-compositors.mjs && npm run build && electron-builder --mac --x64",
    "dist:win": "node scripts/install-cross-compositors.mjs && npm run build && electron-builder --win",
    "dist:linux": "node scripts/install-cross-compositors.mjs && npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.screenlet.app",
    "productName": "Screenlet",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "asar": false,
    "asarUnpack": [
      "node_modules/@remotion/compositor-*/**/*"
    ],
    "files": [
      "out/**/*",
      "electron/**/*",
      "scripts/**/*",
      "node_modules/@remotion/compositor-darwin-arm64/**/*",
      "node_modules/@remotion/compositor-darwin-x64/**/*",
      "node_modules/@remotion/compositor-win32-x64-msvc/**/*",
      "node_modules/@remotion/compositor-linux-x64-gnu/**/*",
      "node_modules/@remotion/compositor-linux-arm64-gnu/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "public/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "dmg": {
      "title": "Screenlet",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.2.8",
    "@remotion/bundler": "^4.0.478",
    "@remotion/cli": "^4.0.478",
    "@remotion/player": "^4.0.478",
    "@remotion/renderer": "^4.0.478",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.20.0",
    "next": "^15.5.19",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.478",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@remotion/compositor-darwin-arm64": "4.0.478",
    "@remotion/compositor-darwin-x64": "4.0.478",
    "@remotion/compositor-linux-arm64-gnu": "4.0.478",
    "@remotion/compositor-linux-x64-gnu": "4.0.478",
    "@remotion/compositor-win32-x64-msvc": "4.0.478"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "wait-on": "^9.0.10"
  }
}
